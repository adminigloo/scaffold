{
  "name": "@adminigloo/assistant",
  "version": "0.10.0",
  "description": "An AI assistant for each company, installed into your own app: a personality, business profile, FAQs, house rules and glossary the owner writes in plain words; a whitelisted tool loop that runs as the signed-in person and asks before it changes anything; keyword knowledge search (no database extension); a monthly allowance it checks before every model call; and every token metered from the provider's counts.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/assistant"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js",
      "require": "./dist/anthropic.cjs"
    },
    "./vector": {
      "types": "./dist/vector.d.ts",
      "import": "./dist/vector.js",
      "require": "./dist/vector.cjs"
    },
    "./sql/*": "./sql/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "sql",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@adminigloo/db": "workspace:^",
    "@adminigloo/license": "workspace:^"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:peers",
    "zod": "catalog:peers",
    "@anthropic-ai/sdk": ">=0.122.0"
  },
  "devDependencies": {
    "drizzle-orm": "catalog:",
    "zod": "catalog:",
    "@anthropic-ai/sdk": "^0.122.0",
    "@electric-sql/pglite": "^0.5.8"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  }
}
