{
  "name": "@adminigloo/analytics",
  "version": "0.2.0",
  "description": "First-party, cookieless traffic analytics for an app's own site: where visitors come from (search, AI assistants by engine, social, campaigns), what they read and click, how fast it loads, and which AI crawlers are reading it — kept in the app's own database under a table prefix you choose, with staff, testers and automation left out of every report through @adminigloo/audience.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/analytics"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "require": {
        "types": "./dist/schema.d.cts",
        "default": "./dist/schema.cjs"
      }
    },
    "./crawlers": {
      "import": {
        "types": "./dist/crawlers.d.ts",
        "default": "./dist/crawlers.js"
      },
      "require": {
        "types": "./dist/crawlers.d.cts",
        "default": "./dist/crawlers.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./dashboard": {
      "import": {
        "types": "./dist/dashboard.d.ts",
        "default": "./dist/dashboard.js"
      },
      "require": {
        "types": "./dist/dashboard.d.cts",
        "default": "./dist/dashboard.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@adminigloo/db": "workspace:^",
    "@adminigloo/license": "workspace:^",
    "web-vitals": "^6.2.2"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:peers",
    "zod": "catalog:peers",
    "react": "^18.0.0 || ^19.0.0",
    "@adminigloo/audience": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@adminigloo/audience": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adminigloo/audience": "workspace:^",
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "catalog:",
    "zod": "catalog:",
    "react": "^19.2.4",
    "@types/react": "^19.2.7"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
