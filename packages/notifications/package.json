{
  "name": "@adminigloo/notifications",
  "version": "0.2.0",
  "description": "Alerts for each company and each person in it: a bell with their own company's alerts in plain words, each person's choice of in the app or also by email, one place where the owner picks who hears about new work, and alert emails under the company's name. Durable in your own database, with handlers for @adminigloo/notifications-widget.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/notifications"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./sql/*": "./sql/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "sql",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "uuidv7": "^1.2.1"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:peers",
    "zod": "catalog:peers"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
