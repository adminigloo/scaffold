__SCOPE__:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
# Shorter folder names inside node_modules/.pnpm (pnpm's default is 60 on
# Windows). pnpm keeps each package several folders deep, and on Windows the
# Next.js build can't read a file whose full path is over 260 characters: with
# the default, a project in a long folder stops with "Module not found: Can't
# resolve '__SCOPE__/…-widget/admin'". 40 keeps every package 20 characters
# shallower; names stay unique (pnpm adds a hash). Harmless everywhere else.
virtual-store-dir-max-length=40
