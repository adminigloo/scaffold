{
  "name": "@adminigloo/license",
  "version": "0.1.0",
  "description": "Runtime license verification for AdminIgloo features. Verifies an Ed25519-signed license token offline, gates a feature per a per-deployment mode, and — unconfigured — allows everything so nothing breaks.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/license"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "zod": "catalog:peers"
  },
  "devDependencies": {
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
