{
  "name": "@adminigloo/tenancy-widget",
  "version": "0.2.1",
  "description": "The screens for AdminIgloo companies: onboarding (name your company), the company switcher, the setup checklist, the team page (invite, change roles, remove, leave, transfer ownership) and company settings, plus the operator console under ./admin (companies, suspend and reactivate, staff roles). Talks to @adminigloo/tenancy's handlers. React is its only peer.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/tenancy-widget"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js",
      "require": "./dist/admin.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@adminigloo/tenancy": "^0.6.0"
  },
  "peerDependenciesMeta": {
    "@adminigloo/tenancy": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adminigloo/tenancy": "workspace:^",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
