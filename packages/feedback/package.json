{
  "name": "@adminigloo/feedback",
  "version": "0.7.1",
  "description": "The feedback platform primitive: client-key licensing, the config/upload/submit HTTP contract the feedback widget speaks, and the Kanban board for triaging what arrives.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/feedback"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./board": {
      "types": "./dist/board.d.ts",
      "import": "./dist/board.js",
      "require": "./dist/board.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@adminigloo/db": "workspace:^"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:peers",
    "zod": "catalog:peers",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "drizzle-orm": "catalog:",
    "zod": "catalog:",
    "react": "^19.2.4",
    "@types/react": "^19.2.7"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
