{
  "name": "@adminigloo/commerce",
  "version": "0.4.0",
  "description": "One-time purchases, and a store of its own for every business: cart maths in integer minor units, orders keyed on the Checkout Session, server-priced checkout with stock held under a lock, and the store's screens.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/commerce"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./store": {
      "types": "./dist/store-server.d.ts",
      "import": "./dist/store-server.js",
      "require": "./dist/store-server.cjs"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js",
      "require": "./dist/widget.cjs"
    }
  },
  "files": [
    "dist",
    "sql"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@adminigloo/db": "workspace:^",
    "@adminigloo/permissions": "workspace:^",
    "@adminigloo/stripe": "workspace:^",
    "@adminigloo/catalog": "workspace:^"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:peers",
    "stripe": "catalog:peers",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@adminigloo/tenancy": "workspace:^",
    "drizzle-orm": "catalog:",
    "stripe": "catalog:",
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
