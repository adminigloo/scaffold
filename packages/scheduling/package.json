{
  "name": "@adminigloo/scheduling",
  "version": "0.6.0",
  "description": "Field-service scheduling in the business's own time zone: customers book online and manage their visit from an emailed link, staff accept, move and reassign visits on a calendar, crews get today's route, and unanswered requests expire. Drive times come from Google Maps when you pass a key (selectMapsProvider), or straight-line estimates without one. Emails and reminders via ./comms.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/scheduling"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./comms": {
      "types": "./dist/comms.d.ts",
      "import": "./dist/comms.js",
      "require": "./dist/comms.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@adminigloo/db": "workspace:^"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:peers",
    "zod": "catalog:peers",
    "@adminigloo/comms": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "@adminigloo/comms": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adminigloo/comms": "workspace:^",
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
