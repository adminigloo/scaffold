{
  "name": "@adminigloo/email",
  "version": "0.2.0",
  "description": "Transactional email with a delivery log. With no API key a send is recorded as skipped instead of throwing, so every feature that sends mail still works before anyone has found a credential.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/email"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./emails": {
      "types": "./dist/emails.d.ts",
      "import": "./dist/emails.js",
      "require": "./dist/emails.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@adminigloo/db": "workspace:^",
    "@adminigloo/env": "workspace:^",
    "@react-email/components": "^1.0.12",
    "svix": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:peers",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "catalog:peers"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "drizzle-orm": "catalog:",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsup src/index.ts src/schema.ts src/emails.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
