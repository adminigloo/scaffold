{
  "name": "@adminigloo/billing",
  "version": "0.1.2",
  "description": "Subscriptions and entitlements: a local plan catalog, what a purchase grants, and proration.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/billing"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@adminigloo/db": "workspace:^",
    "@adminigloo/permissions": "workspace:^"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:peers"
  },
  "devDependencies": {
    "drizzle-orm": "catalog:"
  },
  "scripts": {
    "build": "tsup src/index.ts src/schema.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
