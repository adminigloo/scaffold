{
  "name": "@adminigloo/feedback-widget",
  "version": "0.1.0",
  "description": "The sellable feedback widget: screenshot capture, annotation, session recording, and submission to an AdminIgloo feedback platform — React is its only peer.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/feedback-widget"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
