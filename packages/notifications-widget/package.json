{
  "name": "@adminigloo/notifications-widget",
  "version": "0.1.1",
  "description": "The alerts screens for AdminIgloo notifications, under ./admin: the bell in the header with each person's unread alerts for their company, the full alerts page, and Alert settings (how each person hears about each kind of alert, and who in the company hears about new work). Talks to @adminigloo/notifications's handlers. React is its only peer.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/notifications-widget"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js",
      "require": "./dist/admin.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@adminigloo/notifications": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@adminigloo/notifications": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adminigloo/notifications": "workspace:^",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
