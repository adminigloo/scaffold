{
  "name": "@adminigloo/invoicing-widget",
  "version": "0.1.1",
  "description": "The screens for AdminIgloo invoices: the customer's own invoice page (open by its link, no account) and, under ./admin, the ledger a business works from (raise an invoice, edit its lines, record and reverse payments, email it to the customer). Talks to @adminigloo/invoicing's handlers. React is its only peer.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/invoicing-widget"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js",
      "require": "./dist/admin.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@adminigloo/invoicing": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "@adminigloo/invoicing": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adminigloo/invoicing": "workspace:^",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
