{
  "name": "@adminigloo/aeo",
  "version": "0.3.0",
  "description": "AI mentions, per company: for the questions your customers ask an AI assistant, does the answer name you? Asked with web search, read by code (named or not, the quote, the sources, the competitors), metered against each company's AI allowance, and trended week by week.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/aeo"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "require": {
        "types": "./dist/schema.d.cts",
        "default": "./dist/schema.cjs"
      }
    },
    "./anthropic": {
      "import": {
        "types": "./dist/anthropic.d.ts",
        "default": "./dist/anthropic.js"
      },
      "require": {
        "types": "./dist/anthropic.d.cts",
        "default": "./dist/anthropic.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      },
      "require": {
        "types": "./dist/ui.d.cts",
        "default": "./dist/ui.cjs"
      }
    },
    "./sql/*": "./sql/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "sql",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@adminigloo/db": "workspace:^"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:peers",
    "zod": "catalog:peers",
    "react": "^18.0.0 || ^19.0.0",
    "@anthropic-ai/sdk": ">=0.122.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "catalog:",
    "zod": "catalog:",
    "react": "^19.2.4",
    "@types/react": "^19.2.7",
    "react-dom": "^19.2.4",
    "@types/react-dom": "^19.2.4",
    "@adminigloo/ai": "workspace:^"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  }
}
