{
  "name": "@adminigloo/aeo",
  "version": "0.1.1",
  "description": "Answer-engine citation tracking: for the questions your customers actually ask, does an AI assistant mention you? Tracks queries, records whether your brand is cited, and trends it over time.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/aeo"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@adminigloo/db": "workspace:^"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:peers",
    "zod": "catalog:peers"
  },
  "devDependencies": {
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
