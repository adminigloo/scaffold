{
  "name": "@adminigloo/observability",
  "version": "0.2.0",
  "description": "Structured logging with this scaffold's real secrets redacted, an audit registry that is the only way to name an action, error fingerprints that survive a redeploy, and a rate limiter with no transport baked in.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/observability"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./request": {
      "types": "./dist/request.d.ts",
      "import": "./dist/request.js",
      "require": "./dist/request.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@adminigloo/db": "workspace:^",
    "@adminigloo/env": "workspace:^"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:peers",
    "pino": "^10.0.0",
    "zod": "catalog:peers"
  },
  "devDependencies": {
    "drizzle-orm": "catalog:",
    "pino": "^10.0.0",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsup src/index.ts src/request.ts src/schema.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
