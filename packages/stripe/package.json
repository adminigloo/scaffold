{
  "name": "@adminigloo/stripe",
  "version": "0.7.0",
  "description": "The Stripe primitive: session creation, signature verification, an event ledger with two-phase idempotency, a typed handler registry, and Connect for companies taking card payments from their own customers.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/stripe"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    }
  },
  "files": [
    "dist",
    "sql"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@adminigloo/db": "workspace:^",
    "@adminigloo/env": "workspace:^",
    "@adminigloo/permissions": "workspace:^"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:peers",
    "stripe": "catalog:peers",
    "zod": "catalog:peers"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "catalog:",
    "stripe": "catalog:",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsup src/index.ts src/schema.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
