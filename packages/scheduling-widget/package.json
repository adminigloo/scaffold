{
  "name": "@adminigloo/scheduling-widget",
  "version": "0.5.0",
  "description": "The client half of AdminIgloo scheduling, for a business whose crews drive to the customer: a visit picker for the business's website and the customer's manage-your-visit page, plus the staff screens under ./admin (a day/week calendar per crew with drag-to-move, today's route for a crew on a phone, and the business settings). React is its only peer.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/scheduling-widget"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js",
      "require": "./dist/admin.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
