{
  "name": "@adminigloo/estimator",
  "version": "0.4.0",
  "description": "Instant estimates priced from the business's own supplies, labor and markup: customers answer what they know (how many steps, a width and a length), code works out every number, a photo is read for counts only (Claude Haiku, budgeted and metered), and staff edit the lead and send a quote the customer accepts online, with follow-ups and expiry.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminigloo/scaffold.git",
    "directory": "packages/estimator"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./comms": {
      "types": "./dist/comms.d.ts",
      "import": "./dist/comms.js",
      "require": "./dist/comms.cjs"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js",
      "require": "./dist/anthropic.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "uuidv7": "^1.2.1"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:peers",
    "zod": "^4.0.0",
    "@adminigloo/comms": "^0.3.0",
    "@anthropic-ai/sdk": ">=0.122.0"
  },
  "peerDependenciesMeta": {
    "@adminigloo/comms": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adminigloo/comms": "workspace:^",
    "@anthropic-ai/sdk": "^0.122.0",
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "catalog:",
    "sharp": "0.34.5",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
